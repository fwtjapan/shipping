# FWT JAPAN 集運系統設定範例
# 本機：複製成 .env 後填值（.env 已被 .gitignore 排除，不會進 Git）
# 部署（Zeabur）：在服務的「環境變數」頁面填同樣的 KEY

# ── 必填 ─────────────────────────────
ADMIN_PASSWORD=請改成強密碼
SESSION_SECRET=請填一串隨機字（例：python -c "import secrets;print(secrets.token_hex(32))"）

# ── 品牌 / 會員頁顯示 ─────────────────
# 留空 = 用 brand.py 裡的預設值（已填好 FWT JAPAN 的倉庫地址、LINE、匯款帳號）
BRAND_NAME=FWT JAPAN
BRAND_COMPANY=FWTJAPAN株式会社
BRAND_SITE_URL=https://fwtjapan.com
BRAND_SIGNUP_URL=https://fwtjapan.com/account/register
BRAND_APP_URL=
BRAND_LINE_ID=
BRAND_WAREHOUSE_ZIP=
BRAND_WAREHOUSE_ADDRESS=
BRAND_WAREHOUSE_PHONE=
BRAND_WAREHOUSE_MAP_URL=
BRAND_BANK_NAME=
BRAND_BANK_ACCOUNT=
BRAND_BANK_HOLDER=
BRAND_INSURANCE_URL=
BRAND_INSURANCE_LABEL=立即加購貨物保險
BRAND_INSURANCE_DESC=貨物保障，每箱上限 5 萬台幣

# ── Shopify（會員來源）────────────────
# 客人的會員編號存在 Shopify 客戶 metafield：custom.<MEMBER_METAFIELD_KEY>
SHOPIFY_STORE=你的店.myshopify.com
SHOPIFY_ACCESS_TOKEN=
MEMBER_METAFIELD_KEY=shipping_member_id
MEMBER_SYNC_AUTO=1

# ── JPD 雲倉 ──────────────────────────
JPD_EMAIL=
JPD_PASSWORD=
JPD_WAREHOUSE_ID=1
JPD_DELIV_ID=40

# ── 運費 / 匯率 ───────────────────────
DEFAULT_SHIPPING_RATE=180
TWD_TO_JPY_RATE=5.0
# 易碎品包裝（每個，日幣）、免費倉儲天數、分層談價門檻（kg/月）
FRAGILE_PACKING_JPY=300
FREE_STORAGE_DAYS=30
TIER_NEGOTIATE_KG=300

# ── 其他 ──────────────────────────────
DB_PATH=packages.db
TRACKING_SHEET_URL=
# 對帳用自家帳號；沒填就用 BRAND_BANK_ACCOUNT
OWN_ACCOUNT=
# 代理商模組（分潤、代理品牌頁）：0=關閉 1=開啟
ENABLE_AGENTS=0

# ── Google Drive 每日備份（tools/get_gdrive_token.py 取 token）──
BACKUP_AUTO=1
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
